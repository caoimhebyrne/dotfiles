{{- /* Homebrew lives in a different place on each platform: /opt/homebrew on
Apple Silicon, /usr/local on Intel macs, and a shared prefix on Linux. Resolve
it once here and reuse it below. */ -}}
{{- $brewPrefix := "/opt/homebrew" -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $brewPrefix = "/home/linuxbrew/.linuxbrew" -}}
{{- else if eq .chezmoi.arch "amd64" -}}
{{- $brewPrefix = "/usr/local" -}}
{{- end -}}
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# Only on the machines that actually have the SDK installed, so the other one
# does not carry a dead PATH entry.
[[ -d "{{ $brewPrefix }}/share/google-cloud-sdk/bin" ]] && export PATH="{{ $brewPrefix }}/share/google-cloud-sdk/bin:$PATH"

eval "$({{ $brewPrefix }}/bin/brew shellenv zsh)"

alias ls="eza --group-directories-first --icons=auto --color=auto"
alias cat="bat"

# pnpm
{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else -}}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# completions
{{ if eq .chezmoi.os "darwin" -}}
{{- /* brew keeps the plugin under its own prefix; Linux gets it from the
distro package instead. */ -}}
zsh_autosuggestions_dir="{{ $brewPrefix }}/share/zsh-autosuggestions"
{{- else -}}
zsh_autosuggestions_dir="/usr/share/zsh-autosuggestions"
{{- end }}
FPATH="$zsh_autosuggestions_dir:$FPATH"
autoload -Uz compinit
compinit
# completions end

# auto suggestions :)
source "$zsh_autosuggestions_dir/zsh-autosuggestions.zsh"

# k9s
# Pin the config dir so it is ~/.config/k9s on Linux and macOS alike; without
# this macOS resolves XDG_CONFIG_HOME to ~/Library/Application Support.
export K9S_CONFIG_DIR="$HOME/.config/k9s"
# k9s converts every skin colour to fixed RGB, which pins the theme to whatever
# the skin hardcodes. Disabling tcell's truecolor makes it emit palette indices
# instead, so the skin renders in the terminal's own colours and follows
# light/dark. Scoped to k9s so other tcell apps keep truecolor.
k9s() { TCELL_TRUECOLOR=disable command k9s "$@" }
# k9s end

eval "$(atuin init zsh --disable-up-arrow)"
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

bindkey "^[[1;5C" forward-word  # ctrl + ->
bindkey "^[[1;5D" backward-word # ctrl + <-
bindkey '^[[H' beginning-of-line # replace ctrl + a cursor start of line
bindkey '^[[F' end-of-line # replace ctrl + e cursor end of line

. "$HOME/.cargo/env"
